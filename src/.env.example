# Supply Chain Disruption Assistant — Environment Variables
# Copy this file to .env and fill in your actual values
# NEVER commit the .env file — it is in .gitignore

# HTTP Server
APP_PORT=8080

# Database
# Use :memory: for in-memory (default, no file needed)
# Use a file path to persist data between restarts, e.g.: ./supply_chain.db
DB_PATH=:memory:

# Frontend
# Path to the frontend directory (relative to where the binary runs)
FRONTEND_DIR=./frontend

# Application environment
APP_ENV=development
